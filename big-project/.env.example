# Environment Configuration Template
# Copy to .env and fill in your values

# ─── Application ───────────────────────────────────────
APP_NAME=AI创作工坊
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ai_workshop:ai_workshop_pass@postgres:5432/ai_workshop
POSTGRES_USER=ai_workshop
POSTGRES_PASSWORD=ai_workshop_pass
POSTGRES_DB=ai_workshop

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Vector Store ──────────────────────────────────────
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# ─── LLM Providers ────────────────────────────────────
# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local (llama.cpp / vLLM)
LOCAL_LLM_BASE_URL=http://localhost:8081/v1
LOCAL_LLM_MODEL=local-model

# ─── Provider Priority (comma-separated) ──────────────
LLM_PROVIDER_PRIORITY=openai,anthropic,local

# ─── Embedding Model ──────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ─── JWT Authentication ───────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ─── Monitoring ───────────────────────────────────────
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:8080","http://localhost:3000"]

# ─── Fine-tuning ──────────────────────────────────────
WANDB_API_KEY=your-wandb-key
HUGGINGFACE_TOKEN=your-hf-token

# ─── SaaS Billing ─────────────────────────────────────
BILLING_ENABLED=true
TOKEN_PRICE_INPUT=0.000003
TOKEN_PRICE_OUTPUT=0.000015
